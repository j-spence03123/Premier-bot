# Required: use real values only in .env, never commit credentials.
DISCORD_TOKEN=
HENRIK_API_KEY=

# Optional: Claude writes match recaps when this is set (paid, prepaid credit; see console.anthropic.com).
ANTHROPIC_API_KEY=
# claude (default) or groq; groq ignores ANTHROPIC_API_KEY.
RECAP_PROVIDER=claude
CLAUDE_RECAP_MODEL=claude-sonnet-5-5
# low, medium or high: higher effort thinks longer and costs more per recap.
CLAUDE_RECAP_EFFORT=medium

# Optional: Groq writes weekly summaries, and match recaps when Claude is off or unavailable
# (free-tier availability and limits vary).
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Model for match feed recaps when Groq writes them; GROQ_MODEL is still used for weekly summaries.
GROQ_RECAP_MODEL=openai/gpt-oss-120b

# Premier team lookup: TEAM_ID takes precedence over name/tag.
TEAM_ID=
TEAM_NAME=YourTeamName
TEAM_TAG=TAG
# Optional comma-separated Riot IDs, e.g. PlayerOne#EU,PlayerTwo#EU
ROSTER=
AFFINITY=eu
# Competitive rotation used by playbook menus; update when Riot changes the pool.
COMPETITIVE_MAPS=Abyss,Bind,Corrode,Haven,Lotus,Summit,Sunset
# Optional guild-specific command sync; otherwise commands sync globally.
GUILD_ID=

# Optional X API schedule lookup.
X_BEARER_TOKEN=
X_USERNAME=
X_KEYWORD=premier
